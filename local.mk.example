# Local development defaults.
# Copy to local.mk if you want overrides. Do not commit local.mk.

PORT := 4600
APP_ENV := development
DATA_STORE := memory
# Set credentials in your untracked local.mk before running make dev or make run-postgres.
# Prefer a private htpasswd file for separate local accounts.
PERMITPAL_USERS_FILE :=
# Or use one users line. Create a preview account with `htpasswd -nB driver`
# and paste its output here; each $ in the hash must be escaped as $$.
PERMITPAL_USERS :=
SESSION_SECRET :=

# Used by make run-postgres and migration targets.
# URL-encode reserved username/password characters before setting this value.
DATABASE_URL :=
