# Local development defaults.
# Copy to local.mk if you want overrides. Do not commit local.mk.

PORT := 4600
APP_ENV := development
DATA_STORE := memory
# Set this in your untracked local.mk before running make dev or make run-postgres.
PERMITPAL_PASSWORD :=
PERMITPAL_PASSWORD_HASH :=
SESSION_SECRET :=

# Used by make run-postgres and migration targets.
# URL-encode reserved username/password characters before setting this value.
DATABASE_URL :=
