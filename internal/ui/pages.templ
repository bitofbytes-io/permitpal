package ui

import (
	"fmt"
	"strings"

	"github.com/drywaters/permitpal/internal/model"
)

templ LoginPage(errorMessage, username string) {
	<!doctype html>
	<html lang="en" class="login-page">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>PermitPal</title>
			<link rel="icon" href="/static/assets/permitpal-logo-mark.png"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			@UmamiScript()
		</head>
		<body class="login-body">
			<main class="login-shell">
				<section class="login-panel" aria-label="Sign in">
					<img class="road-sign-logo" src="/static/assets/permitpal-road-sign-logo.png" alt="PermitPal North Carolina"/>
					<p class="tagline">Your permit pal—less yelling, more tracking.</p>
					<form class="login-form" method="post" action="/login">
						if errorMessage != "" {
							<p class="form-error" role="alert">{ errorMessage }</p>
						}
						<label for="username">Username</label>
						<input id="username" name="username" autocomplete="username" autocapitalize="none" value={ username } autofocus/>
						<label for="password">Password</label>
						<input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password"/>
						<button type="submit">Sign in</button>
					</form>
				</section>
			</main>
			<script>
				// Password managers such as 1Password insert a focusable button inside the
				// username field, so Tab would stop there instead of reaching the password.
				document.getElementById("username").addEventListener("keydown", function (event) {
					if (event.key === "Tab" && !event.shiftKey && !event.altKey && !event.ctrlKey && !event.metaKey) {
						event.preventDefault();
						document.getElementById("password").focus();
					}
				});
			</script>
		</body>
	</html>
}

templ DashboardPage(dashboard model.Dashboard) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>PermitPal Dashboard</title>
			<link rel="icon" href="/static/assets/permitpal-logo-mark.png"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			@UmamiScript()
		</head>
		<body>
			<header class="dash-header">
				<a class="dash-brand" href="/" aria-label="PermitPal home">
					<span class="car-mark" aria-hidden="true"><span></span></span>
					<strong>PermitPal</strong>
				</a>
				<div class="lane-divider" aria-hidden="true"></div>
				<div class="welcome">Welcome back, { dashboard.Driver.DisplayName }!</div>
				<form method="post" action="/logout">
					<button class="logout-button" type="submit">Logout</button>
				</form>
			</header>
			<div class="app-shell">
				<main>
					@ProgressPanel(dashboard)
					<div class="content-grid">
						<aside class="dashboard-side" aria-label="Progress controls">
							<section class="side-panel">
								<h2>Update progress</h2>
								<form class="progress-form" hx-post="/profile" hx-target="#progress-panel" hx-swap="outerHTML">
									<label for="total_hours">Total hours (current)</label>
									<div class="inline-unit">
										<input id="total_hours" name="total_hours" type="text" inputmode="decimal" pattern="(60(\.0)?|[0-5]?[0-9](\.[0-9])?|\.[0-9])" title="Enter 0 to 60 hours, with up to one decimal place" autocomplete="off" value={ model.FormatHours(dashboard.Profile.TotalHours) }/>
										<span>/ 60</span>
									</div>
									<label for="night_hours">Night hours (current)</label>
									<div class="inline-unit">
										<input id="night_hours" name="night_hours" type="text" inputmode="decimal" pattern="(10(\.0)?|[0-9](\.[0-9])?|\.[0-9])" title="Enter 0 to 10 hours, with up to one decimal place" autocomplete="off" value={ model.FormatHours(dashboard.Profile.NightHours) }/>
										<span>/ 10</span>
									</div>
									<label for="permit_issue_date">Permit issue date</label>
									<input id="permit_issue_date" name="permit_issue_date" type="date" value={ model.DateValue(dashboard.Profile.PermitIssueDate) }/>
									<button type="submit">Save progress</button>
								</form>
							</section>
							@PracticeFocus(dashboard, false)
						</aside>
						<section class="dashboard-main" aria-labelledby="checklist-heading">
							<div class="clipboard-shell">
								<div class="clipboard-clip" aria-hidden="true"></div>
								<div class="sheet-title">
									<h1 id="checklist-heading">Road Test Skill Checklist</h1>
								</div>
								<div class="checklist-table" aria-label="Driving skills">
									<div class="checklist-head" role="row">
										<span>#</span>
										<span>Skill</span>
										<span>Bad</span>
<span>Fair</span>
									<span>Good</span>
									<span>Last rated</span>
									<span>Notes</span>
									<span class="save-column">OK</span>
									</div>
									for _, req := range dashboard.Requirements {
										@RequirementRow(req)
									}
								</div>
								<div class="checklist-reference">
									<span>Skills from the NCDMV Level 2 road test score sheet.</span>
									<a href="https://www.ncdot.gov/dmv/license-id/driver-licenses/new-drivers/Pages/level2.aspx" target="_blank" rel="noopener noreferrer">Learn more</a>
								</div>
							</div>
						</section>
					</div>
					<footer class="encouragement-banner">
						<div class="road-dashes" aria-hidden="true"></div>
						<span>Keep practicing</span>
						<p>You’ve got this. Stay consistent!</p>
						<div class="checkers" aria-hidden="true"></div>
					</footer>
				</main>
			</div>
		</body>
	</html>
}

templ UmamiScript() {
	<script>
		(function () {
			if (window.location.hostname !== "permitpal.bitofbytes.io") {
				return;
			}

			var script = document.createElement("script");
			script.async = true;
			script.dataset.websiteId = "f00f467f-a361-4eae-aee2-ef7bbc41ef70";
			script.src = "https://permitpal.bitofbytes.io/umami/script.js";
			document.head.appendChild(script);
		})();
	</script>
}

templ ProgressPanel(dashboard model.Dashboard) {
	@ProgressPanelWithMessage(dashboard, "")
}

templ ProgressPanelWithMessage(dashboard model.Dashboard, savedMessage string) {
	<section id="progress-panel" class="progress-panel" aria-label="Current progress">
		<div class="metric odometer-metric">
			<h2>Current hours</h2>
			<div class="odometer-line">
				<div class="odometer" aria-label={ model.FormatHours(dashboard.Profile.TotalHours) + " total hours" }>
					for _, char := range odometerChars(dashboard.Profile.TotalHours) {
						if char == "." {
							<span class="odo-dot">.</span>
						} else {
							<span>{ char }</span>
						}
					}
				</div>
				<strong>/ 60</strong>
			</div>
			<div class="road-meter" style={ progressStyle(dashboard.TotalPercent) }>
				<span class="road-fill"></span>
				<span class="road-marker">{ model.FormatHours(dashboard.Profile.TotalHours) }</span>
			</div>
		</div>
		<div class="metric odometer-metric">
			<h2>Night hours</h2>
			<div class="odometer-line">
				<div class="odometer" aria-label={ model.FormatHours(dashboard.Profile.NightHours) + " night hours" }>
					for _, char := range odometerChars(dashboard.Profile.NightHours) {
						if char == "." {
							<span class="odo-dot">.</span>
						} else {
							<span>{ char }</span>
						}
					}
				</div>
				<strong>/ 10</strong>
			</div>
			<div class="road-meter" style={ progressStyle(dashboard.NightPercent) }>
				<span class="road-fill"></span>
				<span class="road-marker">{ model.FormatHours(dashboard.Profile.NightHours) }</span>
			</div>
		</div>
		<div class="estimate-sign">
			<h2>Ready estimate</h2>
			<div class="estimate-face">
				<div class="calendar-icon" aria-hidden="true"></div>
				if estimatePrefix, estimateDate, ok := strings.Cut(dashboard.ReadyEstimate, " for "); ok {
					<span>{ estimatePrefix } for</span>
					<strong class="estimate-date">{ estimateDate }</strong>
				} else {
					<strong>{ dashboard.ReadyEstimate }</strong>
				}
			</div>
			if savedMessage != "" {
				<p class="save-feedback" role="status">{ savedMessage }</p>
			}
		</div>
	</section>
}

templ RequirementRow(req model.Requirement) {
	@RequirementRowWithMessage(req, "")
}

templ RequirementRowWithMessage(req model.Requirement, savedMessage string) {
	<form
		id={ "requirement-" + req.Key }
		class={ "checklist-row " + requirementRowClass(req.Rating) }
		hx-post={ "/requirements/" + req.Key }
		hx-target={ "#requirement-" + req.Key }
		hx-swap="outerHTML"
	>
		<div class="row-number">{ fmt.Sprintf("%d", req.SortOrder) }</div>
		<div class="skill-title">
			<h3>{ req.Title }</h3>
<p class="skill-description">{ req.Description }</p>
            <button class="clear-rating" type="button" aria-label={ "Clear rating for " + req.Title }
                hx-post={ "/requirements/" + req.Key } hx-include="closest form" hx-vals='{"clear_rating":"true"}'>Clear rating</button>
		</div>
        <label class="status-cell status-cell--bad">
            <span class="sr-only">Bad</span>
            <input type="radio" name="rating" value="bad" checked?={ req.Rating == model.RatingBad }/>
        </label>
        <label class="status-cell status-cell--fair">
            <span class="sr-only">Fair</span>
            <input type="radio" name="rating" value="fair" checked?={ req.Rating == model.RatingFair }/>
        </label>
        <label class="status-cell status-cell--good">
            <span class="sr-only">Good</span>
            <input type="radio" name="rating" value="good" checked?={ req.Rating == model.RatingGood }/>
        </label>
		<label class="date-field">
			<span class="sr-only">Last rated</span>
			<input name="rated_on" type="date" value={ model.DateValue(req.RatedOn) }/>
		</label>
		<label class="notes-field">
			<span class="sr-only">Notes</span>
			<input name="notes" value={ req.Notes }/>
		</label>
		<button class="row-save" type="submit" aria-label={ "Update " + req.Title }>
			if savedMessage != "" {
				<span class="row-save-feedback" role="status">{ savedMessage }</span>
			} else {
				<span>OK</span>
			}
		</button>
	</form>
}

 templ PracticeFocus(dashboard model.Dashboard, outOfBand bool) {
							<section id="practice-focus" class="side-panel practice-panel"
if outOfBand {
hx-swap-oob="outerHTML"
}>
								<div class="practice-heading">
									<span class="traffic-cone-icon" aria-hidden="true"></span>
									<div>
										<h2>Practice focus</h2>
									</div>
								</div>
								<ol>
									for _, req := range dashboard.PracticeFocus {
										<li>{ req.Title }</li>
									}
								</ol>
								<p class="practice-note">Focus on these skills during your next few drives.</p>
							</section>
}

templ RequirementUpdate(req model.Requirement, dashboard model.Dashboard) {
@RequirementRowWithMessage(req,"Saved")
@PracticeFocus(dashboard,true)
}
