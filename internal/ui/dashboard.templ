package ui

import (
	"fmt"

	"github.com/drywaters/permitpal/internal/model"
)

// DashboardPage is the signed-in page. Hour-progress partials live in
// hours.templ, and checklist rows live in checklist.templ.
templ DashboardPage(dashboard model.Dashboard) {
	<!doctype html>
	<html lang="en">
		@pageHead("PermitPal Dashboard") {
			<script src="/static/htmx.min.js" defer></script>
		}
		<body>
			<header class="dash-header">
				<a class="dash-brand" href="/" aria-label="PermitPal home">
					<span class="car-mark" aria-hidden="true"><span></span></span>
					<strong>PermitPal</strong>
				</a>
				<div class="lane-divider" aria-hidden="true"></div>
				<div class="welcome">Welcome back, { dashboard.Driver.DisplayName }!</div>
				<form method="post" action="/logout">
					<button class="logout-button" type="submit">Logout</button>
				</form>
			</header>
			<div class="app-shell">
				<main>
					@RoadTestReadinessCard(dashboard, false)
					@ProgressPanel(dashboard)
					<div class="content-grid">
						<aside class="dashboard-side" aria-label="Progress controls">
							<section class="side-panel">
								<h2>Update progress</h2>
								<form id="progress-form" class="progress-form" hx-post="/profile" hx-target="#progress-panel" hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt="#progress-form button, #progress-form input">
									<label for="total_hours">Total hours (current)</label>
									<div class="inline-unit">
										<input id="total_hours" name="total_hours" type="text" inputmode="decimal" pattern={ recordedHoursPattern } title={ fmt.Sprintf("Enter 0 to %d hours, with up to one decimal place", model.MaxRecordedHours) } autocomplete="off" value={ model.FormatHours(dashboard.Profile.TotalHours) }/>
										<span>hours</span>
									</div>
									<label for="night_hours">Night hours (current)</label>
									<div class="inline-unit">
										<input id="night_hours" name="night_hours" type="text" inputmode="decimal" pattern={ recordedHoursPattern } title={ fmt.Sprintf("Enter 0 to %d hours, with up to one decimal place", model.MaxRecordedHours) } autocomplete="off" value={ model.FormatHours(dashboard.Profile.NightHours) }/>
										<span>hours</span>
									</div>
									<label for="permit_issue_date">Permit issue date</label>
									<input id="permit_issue_date" name="permit_issue_date" type="date" value={ model.DateValue(dashboard.Profile.PermitIssueDate) }/>
									<p class="entry-note">Keep recording current totals beyond 60 total and 10 night hours when needed. Increases count in the Monday–Sunday week saved, using the entry date rather than the drive date. Corrections remove the newest matching hours first.</p>
									<button type="submit">Save progress</button>
									<p class="form-error" role="alert" hidden></p>
								</form>
							</section>
							@PracticeFocus(dashboard, false)
							@WhatsLeft(dashboard, false)
						</aside>
						<section class="dashboard-main" aria-labelledby="checklist-heading">
							<div class="clipboard-shell">
								<div class="clipboard-clip" aria-hidden="true"></div>
								<div class="sheet-title">
									<h1 id="checklist-heading">Road Test Skill Checklist</h1>
								</div>
								<div class="checklist-toolbar" role="group" aria-label="Checklist order">
									<button type="button" class="is-selected" data-checklist-view="sheet" aria-pressed="true">All skills</button>
									<button type="button" data-checklist-view="recent" aria-pressed="false">Recently mastered</button>
								</div>
								<p id="checklist-empty" class="checklist-empty" hidden>No skills are mastered yet.</p>
								<div class="checklist-table" aria-label="Driving skills">
									<div class="checklist-head" role="row">
										<span>#</span>
										<span>Skill</span>
										<span>Bad</span>
<span>Fair</span>
									<span>Good</span>
									<span>Last rated</span>
									<span>Notes</span>
									<span class="save-column">OK</span>
									</div>
									for _, req := range dashboard.Requirements {
										@RequirementRow(req)
									}
								</div>
								<div class="checklist-reference">
									<span>Skills from the NCDMV Level 2 road test score sheet.</span>
									<a href="https://www.ncdot.gov/dmv/license-id/driver-licenses/new-drivers/Pages/level2.aspx" target="_blank" rel="noopener noreferrer">Learn more</a>
								</div>
							</div>
						</section>
					</div>
					<footer class="encouragement-banner">
						<div class="road-dashes" aria-hidden="true"></div>
						<span>Keep practicing</span>
						<p>You’ve got this. Stay consistent!</p>
						<div class="checkers" aria-hidden="true"></div>
					</footer>
				</main>
			</div>
			<script nonce={ templ.GetNonce(ctx) }>
				// htmx does not swap error responses, so show a rejected save's plain-text
				// message in the form that sent it. The clear-rating button's requests
				// belong to its row. Each form sends one save at a time (hx-sync and
				// hx-disabled-elt on the form), so a second save from the same form is
				// dropped rather than queued. Hours and skill responses both replace
				// the readiness card, so a save from another form waits until the one
				// in flight has been applied. An older response then cannot overwrite
				// a newer change.
				(function () {
					var forms = "#progress-form, .checklist-row";
					var inflight = new Set();
					var waiting = [];

					function saveForm(elt) {
						return elt && elt.closest ? elt.closest(forms) : null;
					}

					function releaseNext() {
						// A released save can fail to start: the field was edited
						// invalid while it waited, or its row was already replaced.
						// Skip it and keep going, or later saves stay queued.
						while (inflight.size === 0 && waiting.length > 0) {
							var next = waiting.shift();
							if (!next.form.isConnected) {
								continue;
							}
							next.issue(true);
						}
					}

					function waitingOn(form) {
						for (var i = 0; i < waiting.length; i++) {
							if (waiting[i].form === form) {
								return true;
							}
						}
						return false;
					}

					function clearFeedback(form) {
						var error = form.querySelector(".form-error");
						error.hidden = true;
						error.textContent = "";
						if (form.id === "progress-form") {
							var progressSaved = document.querySelector("#progress-panel .save-feedback");
							if (progressSaved) {
								progressSaved.remove();
							}
							return;
						}
						var rowSaved = form.querySelector(".row-save-feedback");
						if (rowSaved) {
							var ok = document.createElement("span");
							ok.textContent = "OK";
							rowSaved.replaceWith(ok);
						}
					}

					// Confirm runs before hx-sync. A same-form repeat is left for
					// hx-sync to drop. A different form is held and issued only
					// after the in-flight save's response has been applied.
					document.addEventListener("htmx:confirm", function (event) {
						var form = saveForm(event.detail.elt);
						if (!form || inflight.has(form)) {
							return;
						}
						// This form is already waiting, and it has no request yet
						// for hx-sync to drop. Discard the repeat.
						if (waitingOn(form)) {
							event.preventDefault();
							return;
						}
						if (inflight.size === 0 && waiting.length === 0) {
							return;
						}
						event.preventDefault();
						waiting.push({ form: form, issue: event.detail.issueRequest });
					});

					document.addEventListener("htmx:beforeRequest", function (event) {
						var form = saveForm(event.detail.elt);
						if (!form) {
							return;
						}
						if (!inflight.has(form)) {
							inflight.add(form);
							// The listener sits on the form that issued the save. htmx
							// swaps a skill row out of the document before afterRequest,
							// and a detached node does not bubble to document.
							form.addEventListener("htmx:afterRequest", function onDone() {
								form.removeEventListener("htmx:afterRequest", onDone);
								inflight.delete(form);
								releaseNext();
							});
						}
						var xhr = event.detail.xhr;
						clearFeedback(form);
						// htmx handles the response first: it swaps the row on success and
						// re-enables a rejected row's controls.
						xhr.addEventListener("load", function () {
							if (xhr.status !== 400) {
								return;
							}
							var error = form.querySelector(".form-error");
							error.textContent = xhr.responseText.trim();
							error.hidden = error.textContent === "";
						});
					});
				})();

				// Recently mastered hides skills that are still in practice and
				// orders the rest by sign-off date, newest first. Sheet order is
				// the numbered road-test order. Only a checklist swap refreshes
				// the view, and rows move only when that order changed, so a save
				// does not steal focus from another skill.
				(function () {
					var table = document.querySelector(".checklist-table");
					var buttons = document.querySelectorAll("[data-checklist-view]");
					var empty = document.getElementById("checklist-empty");
					if (!table || buttons.length === 0) {
						return;
					}

					function rows() {
						return Array.prototype.slice.call(table.querySelectorAll(".checklist-row"));
					}

					function masteredLabel(value) {
						var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
						if (!match) {
							return "";
						}
						var year = Number(match[1]);
						var month = Number(match[2]);
						var day = Number(match[3]);
						var date = new Date(year, month - 1, day);
						if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) {
							return "";
						}
						return "Mastered " + date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
					}

					function showEditedDate(input) {
						var text = input.parentNode && input.parentNode.querySelector(".mastered-status-text");
						if (!text) {
							return;
						}
						var label = masteredLabel(input.value);
						text.textContent = label;
						input.setAttribute("aria-label", label || "Mastered date");
					}

					table.addEventListener("input", function (event) {
						if (event.target && event.target.name === "rated_on") {
							showEditedDate(event.target);
						}
					});
					table.addEventListener("change", function (event) {
						if (event.target && event.target.name === "rated_on") {
							showEditedDate(event.target);
						}
					});

					function apply(view) {
						var list = rows();
						var sorted = list.slice().sort(function (a, b) {
							if (view === "recent") {
								var am = a.getAttribute("data-mastered") || "";
								var bm = b.getAttribute("data-mastered") || "";
								if (am !== bm) {
									return bm.localeCompare(am);
								}
							}
							return Number(a.getAttribute("data-order")) - Number(b.getAttribute("data-order"));
						});
						var visible = 0;
						sorted.forEach(function (row) {
							var show = view !== "recent" || row.hasAttribute("data-mastered");
							row.hidden = !show;
							if (show) {
								visible++;
							}
						});
						var sameOrder = list.length === sorted.length;
						for (var i = 0; sameOrder && i < sorted.length; i++) {
							if (list[i] !== sorted[i]) {
								sameOrder = false;
							}
						}
						if (!sameOrder) {
							var focus = document.activeElement;
							var range = null;
							if (focus && typeof focus.selectionStart === "number") {
								range = { start: focus.selectionStart, end: focus.selectionEnd };
							}
							sorted.forEach(function (row) {
								table.appendChild(row);
							});
							if (focus && document.contains(focus) && typeof focus.focus === "function") {
								focus.focus();
								if (range && typeof focus.setSelectionRange === "function") {
									focus.setSelectionRange(range.start, range.end);
								}
							}
						}
						if (empty) {
							empty.hidden = view !== "recent" || visible !== 0;
						}
						Array.prototype.forEach.call(buttons, function (button) {
							var on = button.getAttribute("data-checklist-view") === view;
							button.classList.toggle("is-selected", on);
							button.setAttribute("aria-pressed", on ? "true" : "false");
						});
					}

					Array.prototype.forEach.call(buttons, function (button) {
						button.addEventListener("click", function () {
							apply(button.getAttribute("data-checklist-view"));
						});
					});
					document.addEventListener("htmx:afterSwap", function (event) {
						var detail = event.detail || {};
						var target = detail.target;
						var elt = detail.elt;
						var inChecklist = target && target.closest && (target.closest(".checklist-table") || target.classList.contains("checklist-table"));
						var fromRow = elt && elt.closest && elt.closest(".checklist-row");
						if (!inChecklist && !fromRow) {
							return;
						}
						var selected = document.querySelector("[data-checklist-view].is-selected");
						if (selected) {
							apply(selected.getAttribute("data-checklist-view"));
						}
					});
				})();
			</script>
		</body>
	</html>
}

 templ PracticeFocus(dashboard model.Dashboard, outOfBand bool) {
							<section id="practice-focus" class="side-panel practice-panel"
if outOfBand {
hx-swap-oob="outerHTML"
}>
								<div class="practice-heading">
									<span class="traffic-cone-icon" aria-hidden="true"></span>
									<div>
										<h2>Practice focus</h2>
									</div>
								</div>
								<ol>
									for _, req := range dashboard.PracticeFocus {
										<li>{ req.Title }</li>
									}
								</ol>
								<p class="practice-note">Focus on these skills during your next few drives.</p>
							</section>
}

// WhatsLeft counts down to the end of the permit hold and lists the road-test
// requirements that hours and skill ratings do not cover.
templ WhatsLeft(dashboard model.Dashboard, outOfBand bool) {
	<section
		id="whats-left"
		class="side-panel whats-left-panel"
		aria-labelledby="whats-left-heading"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		<h2 id="whats-left-heading">What’s left</h2>
		if hold := dashboard.PermitHold; hold.Ends == nil {
			<p class="hold-countdown-note">Add your permit issue date to count down the { fmt.Sprint(model.MinPermitHoldMonths) }-month hold.</p>
		} else if hold.DaysLeft > 0 {
			<p class="hold-countdown"><strong>{ fmt.Sprint(hold.DaysLeft) }</strong> { daysWord(hold.DaysLeft) } to go</p>
			<p class="hold-countdown-note">{ fmt.Sprint(model.MinPermitHoldMonths) }-month hold ends { model.DisplayDate(hold.Ends) }</p>
		} else {
			<p class="hold-countdown hold-countdown--done"><strong>Hold complete</strong></p>
			<p class="hold-countdown-note">{ fmt.Sprint(model.MinPermitHoldMonths) }-month hold ended { model.DisplayDate(hold.Ends) }</p>
		}
		<ul class="road-test-steps">
			for _, step := range model.RoadTestSteps(dashboard.PermitHold) {
				<li>
					<strong>{ step.Title }</strong>
					<span>{ step.Detail }</span>
				</li>
			}
		</ul>
	</section>
}
