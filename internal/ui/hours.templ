package ui

import (
	"fmt"

	"github.com/drywaters/permitpal/internal/model"
)

templ ProgressPanel(dashboard model.Dashboard) {
	@ProgressPanelWithMessage(dashboard, "")
}

templ ProgressPanelWithMessage(dashboard model.Dashboard, savedMessage string) {
	<section id="progress-panel" class="progress-panel" aria-label="Current progress">
		@hoursGauge("Current hours", "total hours", dashboard.Profile.TotalHours, model.TotalHoursRequired, dashboard.TotalPercent)
		@hoursGauge("Night hours", "night hours", dashboard.Profile.NightHours, model.NightHoursRequired, dashboard.NightPercent)

		<div class="estimate-sign">
			<h2>Ready estimate</h2>
			<div class="estimate-face">
				<div class="calendar-icon" aria-hidden="true"></div>
				if date := dashboard.ReadyEstimate.Date; date != nil {
					<span>{ estimateLabel(dashboard.ReadyEstimate.WaitingOn) }</span>
					<strong class="estimate-date">{ date.Format("January 2, 2006") }</strong>
				} else {
					<strong>{ dashboard.ReadyEstimate.Hint }</strong>
				}
			</div>
			if note := estimateNote(dashboard.ReadyEstimate.WaitingOn); note != "" {
				<p class="estimate-note">{ note }</p>
			}
			if savedMessage != "" {
				<p class="save-feedback" role="status">{ savedMessage }</p>
			}
		</div>
        <div class="hour-credit" aria-label="Weekly credited hours">
            <p>Weekly credited hours: { model.FormatHours(dashboard.HourCredit.TotalHours) } total, including { model.FormatHours(dashboard.HourCredit.NightHours) } night.</p>
            <p>Up to 10 total hours per Monday–Sunday entry week; night hours count within that limit.</p>
            if date := dashboard.HourCredit.LastRecordedOn; date != nil {
                <p>Last recorded entry date: { model.DisplayDate(date) }. This is the save date, not the actual drive date.</p>
            }
            if dashboard.HourCredit.UndatedTotal > 0 {
                <p>Includes { model.FormatHours(dashboard.HourCredit.UndatedTotal) } undated opening hours ({ model.FormatHours(dashboard.HourCredit.UndatedNight) } night). Their weekly credit cannot be verified.</p>
            }
        </div>
	</section>
}

templ hoursGauge(heading, unit string, hours, required float64, percent int) {
	<div class="metric odometer-metric">
		<h2>{ heading }</h2>
		<div class="odometer-line">
			<div class="odometer" aria-label={ model.FormatHours(hours) + " " + unit }>
				for _, char := range odometerChars(hours) {
					if char == "." {
						<span class="odo-dot">.</span>
					} else {
						<span>{ char }</span>
					}
				}
			</div>
			<strong>{ fmt.Sprintf("/ %g", required) }</strong>
		</div>
		<div class="road-meter" style={ progressStyle(percent) }>
			<span class="road-fill"></span>
			<span class="road-marker">{ model.FormatHours(hours) }</span>
		</div>
	</div>
}

// ProfileUpdate answers a progress save: the refreshed panel, plus the
// countdown, which follows the permit issue date.
templ ProfileUpdate(dashboard model.Dashboard) {
	@ProgressPanelWithMessage(dashboard, "Progress saved")
	@WhatsLeft(dashboard, true)
}
