package ui

import (
	"fmt"

	"github.com/drywaters/permitpal/internal/model"
)

templ RequirementRow(req model.Requirement) {
	@RequirementRowWithMessage(req, "")
}

templ RequirementRowWithMessage(req model.Requirement, savedMessage string) {
	<form
		id={ "requirement-" + req.Key }
		class={ "checklist-row " + requirementRowClass(req.Rating) }
		data-order={ fmt.Sprintf("%d", req.SortOrder) }
		if masteredOn(req) != "" {
			data-mastered={ masteredOn(req) }
		}
		hx-post={ "/requirements/" + req.Key }
		hx-target={ "#requirement-" + req.Key }
		hx-swap="outerHTML"
		hx-sync="this:drop"
		hx-disabled-elt={ "#requirement-" + req.Key + " button, #requirement-" + req.Key + " input" }
	>
		<div class="row-number">{ fmt.Sprintf("%d", req.SortOrder) }</div>
		<div class="skill-title">
			<h3>{ req.Title }</h3>
<p class="skill-description">{ req.Description }</p>
            <button class="clear-rating" type="button" aria-label={ "Clear rating for " + req.Title }
                hx-post={ "/requirements/" + req.Key } hx-include="closest form" hx-vals='{"clear_rating":"true"}'>Clear rating</button>
		</div>
        <label class="status-cell status-cell--bad">
            <span class="sr-only">Bad</span>
            <input type="radio" name="rating" value="bad" checked?={ req.Rating == model.RatingBad }/>
        </label>
        <label class="status-cell status-cell--fair">
            <span class="sr-only">Fair</span>
            <input type="radio" name="rating" value="fair" checked?={ req.Rating == model.RatingFair }/>
        </label>
        <label class="status-cell status-cell--good">
            <span class="sr-only">Good</span>
            <input type="radio" name="rating" value="good" checked?={ req.Rating == model.RatingGood }/>
        </label>
		if status := masteredStatus(req); status != "" {
			<label class="date-field mastered-status">
				<span class="mastered-status-text" aria-hidden="true">{ status }</span>
				<input name="rated_on" type="date" value={ model.DateValue(req.RatedOn) } aria-label={ status }/>
			</label>
		} else {
			<label class="date-field">
				<span class="sr-only">Last rated</span>
				<input name="rated_on" type="date" value={ model.DateValue(req.RatedOn) }/>
			</label>
		}
		<label class="notes-field">
			<span class="sr-only">Notes</span>
			<input name="notes" value={ req.Notes }/>
		</label>
		<button class="row-save" type="submit" aria-label={ "Update " + req.Title }>
			if savedMessage != "" {
				<span class="row-save-feedback" role="status">{ savedMessage }</span>
			} else {
				<span>OK</span>
			}
		</button>
		<p class="form-error" role="alert" hidden></p>
	</form>
}

templ RequirementUpdate(req model.Requirement, dashboard model.Dashboard) {
	@RequirementRowWithMessage(req, "Saved")
	@PracticeFocus(dashboard, true)
	@RoadTestReadinessCard(dashboard, true)
}
